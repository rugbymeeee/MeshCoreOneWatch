# Fork-only TestFlight pipeline: builds MeshCore One (iPhone + Apple Watch) with your own
# Apple Developer account. .github/workflows/testflight-fork.yml copies this file over
# fastlane/Fastfile in CI, so the upstream fastlane setup is never used or modified.
# Setup steps: ci/testflight-fork/README.md.
require "base64"
require "spaceship"

default_platform(:ios)

UPSTREAM_BUNDLE_ID = "io.pocketmesh.app"
BUNDLE_ID_BASE = ENV.fetch("BUNDLE_ID_BASE")

# Signed targets and the bundle identifiers they ship with.
APP_IDS = {
  "MC1" => BUNDLE_ID_BASE,
  "MC1Widgets" => "#{BUNDLE_ID_BASE}.widgets",
  "MC1Watch" => "#{BUNDLE_ID_BASE}.watchkitapp"
}.freeze

# Registers missing App IDs on the Apple Developer portal. Requires an Admin API key.
def register_bundle_ids
  APP_IDS.each do |target, identifier|
    next if Spaceship::ConnectAPI::BundleId.find(identifier)

    UI.message("Registering bundle ID #{identifier}")
    Spaceship::ConnectAPI::BundleId.create(name: "MeshCore One #{target}", platform: "IOS", identifier: identifier)
  end
end

platform :ios do
  desc "Register bundle IDs, sync signing, build, and upload to TestFlight"
  lane :beta do
    setup_ci

    key = ENV.fetch("ASC_KEY")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: key,
      # Accept the .p8 file pasted as-is or base64-encoded.
      is_key_content_base64: !key.include?("BEGIN PRIVATE KEY")
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    register_bundle_ids

    # Creates the distribution certificate and App Store profiles on the first run,
    # then reuses them from the private certificates repo.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      team_id: ENV.fetch("TEAM_ID"),
      app_identifier: APP_IDS.values,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "main",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('MATCH_GIT_TOKEN')}"),
      git_full_name: "MeshCore One CI",
      git_user_email: "meshcore-one-ci@users.noreply.github.com"
    )

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID_BASE)
    unless app
      UI.user_error!(
        "Bundle IDs and certificates are ready, but no App Store Connect app uses #{BUNDLE_ID_BASE} yet. " \
        "Create it (Apps > + > New App, bundle ID #{BUNDLE_ID_BASE}), then push to the testflight branch again."
      )
    end

    # Ship under your bundle IDs and a distinct name, next to the App Store version.
    File.write("../project.yml", File.read("../project.yml").gsub(UPSTREAM_BUNDLE_ID, BUNDLE_ID_BASE))
    sh("cd .. && make generate")
    display_name = ENV.fetch("APP_DISPLAY_NAME", "MC1 Beta")
    set_info_plist_value(path: "MC1/Info.plist", key: "CFBundleDisplayName", value: display_name)
    set_info_plist_value(path: "MC1Watch/Info.plist", key: "CFBundleDisplayName", value: display_name)

    APP_IDS.each do |target, identifier|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "MC1.xcodeproj",
        team_id: ENV.fetch("TEAM_ID"),
        targets: [target],
        bundle_identifier: identifier,
        code_sign_identity: "Apple Distribution",
        profile_name: "match AppStore #{identifier}"
      )
    end

    # Build numbers must exceed every build already on App Store Connect.
    highest = app.get_builds(includes: nil).map { |build| build.version.to_i }.max || 0
    increment_build_number(build_number: highest + 1, xcodeproj: "MC1.xcodeproj")

    build_app(
      scheme: "MC1",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "MC1.ipa",
      xcargs: "DEVELOPMENT_TEAM='#{ENV.fetch('TEAM_ID')}'"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
